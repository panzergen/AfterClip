root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,md}]
indent_size = 2

[*.qml]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{wav,png,jpg,jpeg,ico,mp4,mkv,mov,avi,m4a,mp3}]
insert_final_newline = false
trim_trailing_whitespace = false
