# Auto detect text files and normalise to LF in the repository.
* text=auto

# Windows scripts need CRLF to run reliably.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Sources stay LF everywhere.
*.py text eol=lf
*.qml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.iss text eol=crlf
*.spec text eol=lf

# Binary assets.
*.wav binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp3 binary
*.mp4 binary
*.mkv binary
*.mov binary
*.avi binary
*.m4a binary
